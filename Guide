# 3. `unread_counts:{userId}:{chatId}`

Purpose: **badge counts + unread messages**

Example:

```text
Chat list screen
 ├ Chat A (2 unread)
 ├ Chat B (5 unread)
```

---

### Redis structure

```text
Key: unread_counts:{userId}:{chatId}
Type: String (counter)
Value: integer
```

Example:

```redis
INCR unread_counts:user123:chat456
SET unread_counts:user123:chat456 0
```

---

### Redis helper

`src/services/unread.service.ts`

```ts
import redis from "../config/redis";

export async function incrementUnread(userId: string, chatId: string) {
  const key = `unread_counts:${userId}:${chatId}`;

  await redis.incr(key);
}

export async function resetUnread(userId: string, chatId: string) {
  const key = `unread_counts:${userId}:${chatId}`;

  await redis.set(key, 0);
}

export async function getUnread(userId: string, chatId: string) {
  const key = `unread_counts:${userId}:${chatId}`;

  const count = await redis.get(key);

  return Number(count || 0);
}
```

