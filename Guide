
# 1. `message_cache:{chatId}:recent`

Purpose: **fast loading of recent messages**

Instead of querying DB every time a chat opens.

### Redis structure

```text
Key: message_cache:{chatId}:recent
Type: List
Max length: 50
TTL: optional (1 hour recommended)
Value: JSON message
```

Example:

```redis
LPUSH message_cache:chat123:recent "{message}"
LTRIM message_cache:chat123:recent 0 49
```

---

### Redis helper

`src/services/messageCache.service.ts`

```ts
import redis from "../config/redis";

export async function cacheMessage(chatId: string, message: any) {
  const key = `message_cache:${chatId}:recent`;

  await redis.lpush(key, JSON.stringify(message));
  await redis.ltrim(key, 0, 49);
  await redis.expire(key, 3600);
}

export async function getCachedMessages(chatId: string) {
  const key = `message_cache:${chatId}:recent`;

  const messages = await redis.lrange(key, 0, 19);

  return messages.map(m => JSON.parse(m)).reverse();
}
```

---

### When used

```text
user opens chat
      ↓
check Redis cache
      ↓
if exists → return instantly
else → query DB
```

