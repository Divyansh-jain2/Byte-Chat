# 2. `offline_messages:{userId}`

Purpose: **store messages for offline users**

Instead of losing messages when user socket is disconnected.

---

### Redis structure

```text
Key: offline_messages:{userId}
Type: List
Max length: 100
Value: JSON message
```

Example:

```redis
LPUSH offline_messages:uuid123 "{message}"
LTRIM offline_messages:uuid123 0 99
```

---

### Redis helper

`src/services/offlineMessage.service.ts`

```ts
import redis from "../config/redis";

export async function queueOfflineMessage(userId: string, message: any) {
  const key = `offline_messages:${userId}`;

  await redis.lpush(key, JSON.stringify(message));
  await redis.ltrim(key, 0, 99);
}

export async function getOfflineMessages(userId: string) {
  const key = `offline_messages:${userId}`;

  const messages = await redis.lrange(key, 0, -1);

  await redis.del(key);

  return messages.map(m => JSON.parse(m));
}
```

---

### When used

```text
message sent
      ↓
check if receiver online
      ↓
if offline → queue message
```

Check online using:

```ts
SISMEMBER online_users userId
```

